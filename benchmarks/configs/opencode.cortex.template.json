{
  "model": "${BENCH_MODEL}",
  "enabled_providers": [
    "${BENCH_PROVIDER}"
  ],
  "providers": {
    "${BENCH_PROVIDER}": {
      "package": "@opencode/ai/providers/openai-compatible",
      "name": "OpenAI-Compatible Gateway",
      "settings": {
        "baseURL": "${BENCH_LLM_BASE_URL}",
        "apiKey": "{env:BENCH_LLM_API_KEY}"
      },
      "models": {
        "${BENCH_MODEL_ID}": {
          "name": "${BENCH_MODEL_ID}",
          "limit": {
            "context": 1000000,
            "output": 65536
          }
        }
      }
    }
  },
  "mcp": {
    "servers": {
      "contextcortex": {
        "type": "remote",
        "url": "${CORTEX_MCP_URL}",
        "disabled": false
      }
    }
  },
  "permission": {
    "bash": "deny",
    "read": "deny",
    "glob": "deny",
    "grep": "deny",
    "edit": "deny",
    "write": "deny",
    "webfetch": "deny",
    "websearch": "deny",
    "list": "deny",
    "task": "deny",
    "subagent": "deny"
  }
}
