{
  "name": "contexthub-frontend",
  "private": true,
  "version": "2.7.0",

  "type": "module",
  "scripts": {
    "dev": "vite --configLoader native",
    "build": "tsc -b && vite build --configLoader native",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run --configLoader native",
    "test:coverage": "vitest run --coverage --configLoader native",
    "test:e2e": "playwright test",
    "inspect:layout": "node --experimental-strip-types scripts/inspect_layout.ts"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^29.1.1",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vite-plugin-theme-editor": "github:spelech/vite-plugin-theme-editor",
    "vitest": "^4.1.10"
  }
}
