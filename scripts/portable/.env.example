# ==============================================================================
# ContextCortex Portable Edition (Windows x64 + User-Space PostgreSQL/pgvector)
# start-contextcortex.bat copies this file to .env on first start.
# Values are read as-is. Do not put quotes around JSON values.
# ==============================================================================
HOST=127.0.0.1
PORT=3000

# Portable PostgreSQL + pgvector (initialized automatically in .\data\pgdata)
PORTABLE_POSTGRES_ENABLED=true
PORTABLE_PG_PORT=54329
VECTOR_STORE=pgvector
VECTOR_STORE_PROVIDER=pgvector

# Data folder (default: .\data next to contextcortex.exe)
# DATA_DIR=D:\ContextCortexData

# OpenAI-compatible AI gateway (LiteLLM, vLLM, Ollama, OpenAI, or internal proxy).
# Use the base URL exactly as the gateway documents it (for example .../v1 or .../api/v3).
OPENAI_API_URL=https://litellm.corp.example.com/v1
OPENAI_API_KEY=your-corporate-api-key

# Embeddings. The portable bundle has no local embedding engine, so use an API model.
# Set the model BEFORE the first start: the vector table dimension is fixed on first start.
EMBEDDING_PROVIDER=api
EMBEDDING_MODEL=text-embedding-3-small

# Optional chat and vision OCR models (you can also select them in the Admin UI)
# CHAT_MODEL=gpt-4o-mini
# VISION_OCR_MODEL=gpt-4o-mini

# Optional extra HTTP headers on every gateway request (JSON object, no outer quotes)
# LLM_EXTRA_HEADERS={"X-User-Agent":"contextcortex","X-User-Name":"jdoe"}

# Folder for tree-sitter grammar DLLs (default: .\grammars next to contextcortex.exe,
# pre-filled by the build). Keep it inside an allowed folder if endpoint protection
# blocks DLLs in other locations.
# TREE_SITTER_LANGUAGE_PACK_CACHE_DIR=D:\ContextCortex\grammars

# Corporate CA certificates: put the .crt or .pem files in .\certs\
# The launcher adds them to the public root CAs and sets SSL_CERT_FILE,
# REQUESTS_CA_BUNDLE, and GIT_SSL_CAINFO. Set SSL_CERT_FILE here only to
# use your own complete bundle instead.
